FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PORT=8080

WORKDIR /app

COPY requirements.telegram.txt ./
RUN pip install --no-cache-dir -r requirements.telegram.txt

COPY telegram_bot.py academia_local.py ./

RUN useradd --system --uid 10002 --create-home --home-dir /home/telegram telegram \
    && chown -R telegram:telegram /app \
    && chmod -R u=rwX,go=rX /app
USER telegram

EXPOSE 8080

# All tokens and URLs arrive from Lockbox/environment at revision deploy time.
CMD ["python", "telegram_bot.py"]
